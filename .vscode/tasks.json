{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "bun: watch",
      "command": "bun",
      "args": ["run", "watch"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "bun",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\$ bun build",
          "endsPattern": "^\\s+extension\\.js",
        },
      },
    },
    {
      "type": "shell",
      "label": "bun: compile",
      "command": "bun",
      "args": ["run", "compile"],
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "problemMatcher": [],
    },
  ],
}
